# ==============================================================================
# Ocean3D & Ocean Data Dashboard - Environment Configuration (.env)
# ==============================================================================
# This file defines real-world oceanographic data source credentials, API tokens,
# and NetCDF file paths.

# ── 0. GOOGLE EARTH & GOOGLE MAPS PLATFORM ────────────────────────────────────
# Provides: High-resolution photographic satellite imagery, hybrid layers & terrain
# Register API key at: https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_EARTH_API_KEY="YOUR_GOOGLE_EARTH_OR_MAPS_API_KEY"

# ── 1. COPERNICUS MARINE SERVICE (CMEMS) ───────────────────────────────────────
# Provides: Global Physical Ocean Analysis (Temperature, Salinity, Mixed Layer Depth)
# Product ID: GLOBAL_MULTIYEAR_PHY_001_030 (1/12° resolution, daily/monthly)
# Register for free API access at: https://marine.copernicus.eu/
CMEMS_USERNAME="YOUR_CMEMS_USERNAME"
CMEMS_PASSWORD="YOUR_CMEMS_PASSWORD"
# Optional: Path to custom downloaded Copernicus NetCDF file
# CMEMS_LOCAL_NETCDF="./data/netcdf/arabian_sea_copernicus_extract.nc"

# ── 2. NOAA OSCAR OCEAN CURRENTS ───────────────────────────────────────────────
# Provides: Ocean Surface Current Analyses Real-time (OSCAR) (u, v velocity components)
# Resolution: 1/3° global grid, 5-day intervals
# Public NOAA CoastWatch ERDDAP endpoint (No authentication required):
NOAA_ERDDAP_URL="https://coastwatch.pfeg.noaa.gov/erddap/griddap/oscar_currents_interim_2019.json"
# Optional: Path to custom downloaded NOAA OSCAR NetCDF file
# NOAA_OSCAR_LOCAL_NETCDF="./data/netcdf/arabian_sea_currents.nc"

# ── 3. NASA OCEAN COLOR / MODIS-AQUA (CHLOROPHYLL-A) ──────────────────────────
# Provides: Chlorophyll-a satellite concentration (mg/m³)
# Product: MODIS-Aqua L3 Mapped Chlorophyll-a (4km spatial resolution)
# Register for free Earthdata app key at: https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_TOKEN="YOUR_EARTHDATA_APP_KEY"
# Optional: Path to custom downloaded NASA NetCDF file
# NASA_CHLOROPHYLL_LOCAL_NETCDF="./data/netcdf/arabian_sea_chlorophyll.nc"

# ── 4. IFREMER / INCOIS ARGO PROFILING FLOATS GDAC ─────────────────────────────
# Provides: Autonomous profiling float vertical profiles (CTD: Temp, Salinity, Pressure)
# Real-time HTTP/FTP GDAC mirror (Free open access):
ARGO_GDAC_HTTP_MIRROR="https://data-argo.ifremer.fr/"
ARGO_GDAC_FTP="ftp://ftp.ifremer.fr/ifremer/argo"
# Local directory for caching float NetCDF files:
ARGO_LOCAL_DIR="./data/argo"

# ── 5. SPATIAL INTERPOLATION & PROXIMITY SETTINGS ─────────────────────────────
# Default method when not specified in query: 'bilinear' or 'nearest'
DEFAULT_INTERPOLATION_METHOD="bilinear"
# Proximity distance threshold (km) to trigger in-situ Argo float comparison
ARGO_PROXIMITY_THRESHOLD_KM=150.0
