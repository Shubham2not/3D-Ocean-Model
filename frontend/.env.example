# Google Earth & Google Maps API Key for 2D Map Satellite Imagery
# Obtain a key from Google Cloud Console (https://console.cloud.google.com/google/maps-apis/credentials)
# with "Maps Tiles API" or "Maps JavaScript API" enabled.
VITE_GOOGLE_EARTH_API_KEY="YOUR_GOOGLE_EARTH_OR_MAPS_API_KEY"
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_EARTH_OR_MAPS_API_KEY"
